---
// acts as a custom footer
const purpleHeart = "\ud83d\udc9c";
const transFlag = "\ud83c\udff3\ufe0f\u200d\u26a7\ufe0f";
const rainbowFlag = "\ud83c\udff3\ufe0f\u200d\ud83c\udf08";
---

<div class="meta sl-flex">
  <span>
    © 2026 GDPatch contributors. Licensed under
    <a href="https://github.com/GDPatch/GDPatch/blob/main/LICENSE">
      the MIT License.
    </a>
  </span>

  <span>
    Made with {purpleHeart + transFlag + rainbowFlag} by
    <a href="https://notnite.com">Jules</a>
    and
    <a href="https://github.com/katietheqt">Katie</a>.
  </span>

  <span>For Alyssa.</span>
</div>

<style>
  .meta {
    flex-direction: column;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
